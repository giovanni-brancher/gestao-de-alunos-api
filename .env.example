# Copie para .env e ajuste os valores. O .env não vai para o repositório.

# Banco usado pelos testes. Mantenha o sufixo -test para não gravar no banco de desenvolvimento.
MONGODB_URI=mongodb://127.0.0.1:27017/gestao-de-alunos-test

# Segredo dos tokens JWT (a API tem um valor padrão para desenvolvimento).
JWT_SECRET=segredo-dev-gestao-de-alunos

# Admin criado pelo seed, usado no login dos testes.
ADMIN_EMAIL=admin@escola.com
ADMIN_SENHA=admin123
